{
    "name": "premmohantyagi/apihub-laravel",
    "description": "ApiHub for Laravel: one unified, driver-based interface over global third-party APIs — payments, AI, email, SMS & messaging, and more.",
    "keywords": ["laravel", "api", "sdk", "integration", "payments", "ai", "openai", "stripe", "twilio", "email", "sms"],
    "homepage": "https://github.com/premmohantyagi/apihub-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Prem Mohan Tyagi",
            "email": "premmohantyagi@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/contracts": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0",
        "pestphp/pest": "^1.22|^2.0|^3.0",
        "laravel/pint": "^1.0",
        "larastan/larastan": "^1.0|^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "ApiHub\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ApiHub\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "pint": "pint",
        "stan": "phpstan analyse --memory-limit=512M"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ApiHub\\Laravel\\ApiHubServiceProvider"
            ],
            "aliases": {
                "Payments": "ApiHub\\Laravel\\Facades\\Payments",
                "Ai": "ApiHub\\Laravel\\Facades\\Ai",
                "Email": "ApiHub\\Laravel\\Facades\\Email",
                "Sms": "ApiHub\\Laravel\\Facades\\Sms"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
